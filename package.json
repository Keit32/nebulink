{
  "name": "nebulink",
  "private": true,
  "version": "0.1.0",
  "description": "Nebulink is a local-first cross-platform personal management app.",
  "author": "Keit",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keit32/nebulink.git"
  },
  "bugs": {
    "url": "https://github.com/Keit32/nebulink/issues"
  },
  "homepage": "https://github.com/Keit32/nebulink#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "prepare": "lefthook install",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:unused": "cd src-tauri && cargo machete"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "lefthook": "^2.2.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
