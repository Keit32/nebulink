{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
    "includes": [
      "**",
      "!src/shared/ui",
      "!src/routeTree.gen.ts",
      "!src/bindings.ts"
    ]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
    "indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
	"javascript": {
		"formatter": {
      "semicolons": "always",
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
